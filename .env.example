# EmailJS credentials for the portfolio contact form
# Obtain these from https://emailjs.com (free tier available)
# NOTE: VITE_ prefix is required for client-side Vite access

# Your EmailJS Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Your EmailJS Public Key (Account -> API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
